<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow JIT compilation for V8 engine in Electron -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow loading of unsigned executable memory (required by Electron) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation (required for some native modules) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Audio input access (for potential future audio input features) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Network client access (for OSC communication) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Network server access (for OSC server) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- File read access -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
